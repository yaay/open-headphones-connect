<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSIX package manifest for the Microsoft Store version.
  build-msix.ps1 fills in the {{…}} values: the identity comes from
  store-identity.json (copied from Partner Center), the version from
  src-tauri/tauri.conf.json.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="{{IdentityName}}"
    Publisher="{{Publisher}}"
    Version="{{Version}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{DisplayName}}</DisplayName>
    <PublisherDisplayName>{{PublisherDisplayName}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="open-headphones-connect.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{DisplayName}}"
        Description="Connect card, battery, noise control and settings for Sony headphones. Unofficial; not affiliated with Sony."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <!-- Start with Windows. Off until the user turns it on; see src-tauri/src/startup.rs. -->
        <desktop:Extension Category="windows.startupTask" Executable="open-headphones-connect.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="OpenHeadphonesConnectStartup" Enabled="false" DisplayName="{{DisplayName}}" />
        </desktop:Extension>

        <!-- Lets the app be started from a command line, for demo mode and traces. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="open-headphones-connect.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="open-headphones-connect.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="bluetooth" />
  </Capabilities>
</Package>
